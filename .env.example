# Copia in .env e personalizza. .env non va committato.

# Percorso del progetto come lo vede Docker Desktop (bind webapp + volumi ./dati).
# Esempio Windows/WSL2: C:\Users\lorenzo\ats-webapp
# oppure /run/desktop/mnt/host/c/Users/lorenzo/ats-webapp
HOST_PROJECT_ROOT=.

# Lascia vuoto POSTGRES_* per usare SQLite (ats_cannabis.db).
# Compila tutti e tre per PostgreSQL (docker-compose.postgres.yml).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

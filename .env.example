# Copia in .env e personalizza. .env non va committato.

# Solo per il servizio compose "webapp" (bind del codice). Le fasi OCR
# montano SEMPRE ./dati rispetto a docker-compose.yml (cartella del repo).
# I PDF per l'interfaccia stanno in ./media, non nei container.
HOST_PROJECT_ROOT=.

# Lascia vuoto POSTGRES_* per usare SQLite (ats_cannabis.db).
# Compila tutti e tre per PostgreSQL (docker-compose.postgres.yml).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

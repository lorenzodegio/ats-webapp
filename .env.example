# Copia in .env e personalizza. .env non va committato (vedi .gitignore).
# Configurazione UNICA: webapp e pipeline (anche in modalita' locale,
# PIPELINE_RUNNER=local) leggono lo stesso .env — il processo pipeline
# nativo eredita l'ambiente del processo webapp che lo lancia.

# ──────────────────────────────────────────────────────────────────────────
# Ambiente
# ──────────────────────────────────────────────────────────────────────────
# "production" attiva: storage obbligatorio e valido (niente fallback
# silenzioso), SESSION_SECRET_KEY obbligatoria, create_all() disattivato
# (schema gestito da Alembic). Qualunque altro valore (o assente) = sviluppo.
APP_ENV=development

# ──────────────────────────────────────────────────────────────────────────
# Database (PostgreSQL). Lascia POSTGRES_* vuote per usare SQLite
# (ats_cannabis.db) in sviluppo. DATABASE_URL, se impostata, ha priorita'
# su entrambe.
# ──────────────────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://utente:password@localhost:5432/ats_webapp_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ats_webapp_db
POSTGRES_USER=ats_webapp
POSTGRES_PASSWORD=

# ──────────────────────────────────────────────────────────────────────────
# Sessione / sicurezza
# ──────────────────────────────────────────────────────────────────────────
# Obbligatoria con APP_ENV=production (l'app non parte senza). Genera con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# Limite dimensione corpo richiesta (upload PDF/Excel), in MB.
MAX_UPLOAD_SIZE_MB=200

# Cartella dei log a rotazione della webapp (10 file da 10MB). Default:
# ./logs nella cartella del progetto.
# LOG_DIR=E:\apps\ocr-cannabis\logs

# ──────────────────────────────────────────────────────────────────────────
# Pipeline OCR — runner
# ──────────────────────────────────────────────────────────────────────────
# "docker" (default, macchina GPU con Docker Desktop/Engine, comportamento
# storico) oppure "local" (processo Python nativo — server senza Docker/WSL2).
PIPELINE_RUNNER=docker
# Richiesti solo con PIPELINE_RUNNER=local: interprete Python dedicato alla
# pipeline (ambiente separato da quello della webapp, vedi docker/pyproject.toml)
# e la radice del repository (dove vivono ocr_cannabis.py/pipeline.py/ecc.,
# run_fase.py li importa da li').
# PIPELINE_PYTHON=E:\apps\ocr-cannabis\docker\.venv\Scripts\python.exe
# PIPELINE_DIR=E:\apps\ocr-cannabis

# ──────────────────────────────────────────────────────────────────────────
# Ollama / modelli
# ──────────────────────────────────────────────────────────────────────────
# Letta automaticamente dal client Python "ollama" (nessun codice applicativo
# la legge direttamente). In modalita' Docker e' gia' impostata nel
# docker-compose.yml dei singoli servizi — qui serve SOLO per PIPELINE_RUNNER=local.
# OLLAMA_HOST=http://127.0.0.1:11434

MODELLO_PESANTE=qwen3-vl:30b-a3b-instruct
MODELLO_LEGGERO=qwen3-vl:8b-instruct
OLLAMA_MODEL=qwen3-vl:30b-a3b-instruct
OLLAMA_MODEL_TESTO=qwen3-vl:8b-instruct

# Contesto del modello pesante (token). Default 16384 se non impostato.
# NUM_CTX=16384

# Thread CPU per chiamata, separati per modello pesante/leggero — utile su
# un server con molti core (es. 40 vCPU). Non impostati = lascia decidere a
# Ollama. Vedi benchmark.py per trovare i valori migliori su QUESTA macchina.
# OLLAMA_NUM_THREAD_PESANTE=30
# OLLAMA_NUM_THREAD_LEGGERO=10

# Quante ricette elaborare in parallelo (thread) durante l'estrazione OCR.
# Default 1 (sequenziale). Utile solo se OLLAMA_NUM_PARALLEL sul servizio
# Ollama e' anch'esso >1 — vedi benchmark.py.
# PIPELINE_PARALLELISMO=1

# Cartella dove sono gia' stati scaricati i modelli EasyOCR (da install.ps1)
# invece di scaricarli al primo avvio reale nel profilo dell'utente che
# esegue il processo.
# EASYOCR_MODEL_DIR=E:\apps\ocr-cannabis\data\models\easyocr

# ──────────────────────────────────────────────────────────────────────────
# Storage permanente (PDF/PNG/Excel/JSON)
# ──────────────────────────────────────────────────────────────────────────
# "onedrive" (default fuori produzione): cartella OneDrive for Business
# sincronizzata, configurata in Impostazioni (Configurazione.sharepoint_base_path).
# "local" (default in produzione): cartella Windows fissa, STORAGE_LOCAL_DIR.
# STORAGE_BACKEND=local
# STORAGE_LOCAL_DIR=E:\apps\ocr-cannabis\data\storage

# ──────────────────────────────────────────────────────────────────────────
# Primo utente admin (solo installer non interattivo — seed_admin.py).
# Se impostata (anche da install.ps1 via Read-Host -AsSecureString), niente
# prompt interattivo: vuota = lo script si ferma, nessun default.
# Non impostarla qui in chiaro per uso manuale: lascia vuoto/assente per il
# prompt interattivo normale.
# ADMIN_INITIAL_PASSWORD=

# ──────────────────────────────────────────────────────────────────────────
# Solo per il servizio Docker "webapp" (bind del codice, macchina GPU) —
# non usato da PIPELINE_RUNNER=local.
# ──────────────────────────────────────────────────────────────────────────
HOST_PROJECT_ROOT=.

# ──────────────────────────────────────────────────────────────────────────
# Notifiche email a fine fase/errore (app/notifiche_email.py)
# ──────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.ats-insubria.it
SMTP_PORT=25
SMTP_MITTENTE=applicazioni_AI@ats-insubria.it
